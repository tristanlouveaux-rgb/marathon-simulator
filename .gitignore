node_modules/
dist/
coverage/
.env.local
ios/
android/
.capacitor/

# Exceptions: Capacitor plugin sources live under ios-plugins/*/ios/ and
# ios-plugins/*/dist/. The broad rules above would otherwise drop the Swift
# implementations + compiled JS bridges, leaving plugins unbuildable from a
# fresh clone.
!ios-plugins/*/ios/
!ios-plugins/*/ios/**
!ios-plugins/*/dist/
!ios-plugins/*/dist/**
.DS_Store
.claude/
.cursor/
.playwright-mcp/
mcp.json
*.docx
*.odt
~$*

# Scratch / design references — not source of truth
*.png
Recovery_score_ux.html
Strain*_Ux.md
test-rpe*.js

# Separate subproject
marque-cli/

# Supabase CLI transient state
supabase/.temp/
.vercel

# Calibration datasets — large CSVs not source of truth (regenerate from Kaggle)
validation/data/

# Swift package build caches for the iOS plugins — regenerable artifacts,
# rebuilt by Xcode/SwiftPM. Were bloating git status with ~1700 files.
ios-plugins/*/.build/

# Per-user Xcode scheme state — managed by SwiftPM, not source.
ios-plugins/*/.swiftpm/
