node_modules/
dist/
coverage/
.env
.env.*
!.env.example
ios/
android/
.capacitor/

# Exceptions: Capacitor plugin sources live under ios-plugins/*/ios/ and
# ios-plugins/*/dist/. The broad rules above would otherwise drop the Swift
# implementations + compiled JS bridges, leaving plugins unbuildable from a
# fresh clone.
!ios-plugins/*/ios/
!ios-plugins/*/ios/**
!ios-plugins/*/dist/
!ios-plugins/*/dist/**
.DS_Store
.claude/
.cursor/
.playwright-mcp/
mcp.json
*.docx
*.odt
~$*

# Scratch / design references — not source of truth
*.png
Recovery_score_ux.html
Strain*_Ux.md
test-rpe*.js

# Separate subproject
marque-cli/

# Supabase CLI transient state
supabase/.temp/
.vercel

# Calibration datasets — large CSVs not source of truth (regenerate from Kaggle)
validation/data/

# Swift package build caches for the iOS plugins — regenerable artifacts,
# rebuilt by Xcode/SwiftPM. Were bloating git status with ~1700 files.
ios-plugins/*/.build/

# Per-user Xcode scheme state — managed by SwiftPM, not source.
ios-plugins/*/.swiftpm/

# Xcode archive + export output from scripts/testflight-upload.sh. Regenerable,
# ~57 MB per build — must never enter git history.
build/

# Scratch: temp profiling scripts and Playwright accessibility-tree dumps.
.tmp-*.mjs
grp*.yml
addbuild.yml

# Marketing media stays on disk, out of git (GitHub refuses files over 100 MB;
# history was cleaned of these on 2026-10-08, see backup/*-with-media branches)
marketing/clips/
marketing/**/*.mov
marketing/**/*.webm
marketing/**/*.mp4
marketing/**/*.zip
